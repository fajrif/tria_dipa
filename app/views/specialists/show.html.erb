
    <!-- Sidebar Page Container -->
    <div class="sidebar-page-container layout-pt-60 layout-pb-100">
      <div class="auto-container">
        <div class="row">
          <!--Sidebar Side-->
          <div class="sidebar-side col-lg-3 col-md-3 col-sm-12">
						<% unless mobile_device? %>
							<aside class="sidebar blog-sidebar d-none d-md-block">
								<!-- Shop Widget -->
								<div class="sidebar-widget catagory-widget bg-green text-white">
									<ul class="catagory-list">
										<% @specialists.each do |specialist| %>
											<li>
												<%= link_to specialist_path(specialist), class: "#{ 'active' if @specialist.id == specialist.id }" do %>
													<%= image_tag specialist.image.variant(resize: "100x100").processed if specialist.image.attached? %> <%= specialist.name.downcase.titleize %>
												<% end %>
											</li>
										<% end %>
									</ul>
								</div>
							</aside>
						<% else %>
							<!--Tabs Box-->
							<div class="default-tabs" id="specialist-list">
								<div class="tab-buttons-wrap">
									<ul class="tab-buttons -pills-condensed -blue">
										<% @specialists.each do |specialist| %>
											<li class="tab-btn <%= 'active-btn' if specialist.id == @specialist.id %>"><%= link_to specialist.name.downcase.titleize, specialist_path(specialist) %></li>
										<% end %>
									</ul>
								</div>
							</div>
						<% end %>
          </div>

          <!--Content Side-->
          <div class="content-side col-lg-9 col-md-9 col-sm-12">

						<!-- Job Block -->
						<div class="job-block-seven">
							<div class="inner-box">
								<div class="content">
									<% if @specialist.image.attached? %>
									<span class="company-logo">
										<%= image_tag @specialist.image.variant(resize: "200x200").processed %>
									</span>
									<% end %>
									<h4><%= @specialist.name.downcase.titleize %></h4>
									<p><%= @specialist.headline %></p>
								</div>
							</div>
						</div>

            <div class="blog-grid">
              <div class="row">
								<% @doctors.each do |doctor| %>
									<div class="candidate-block-two col-lg-6 col-md-6 col-sm-12">
										<div class="inner-box" style="padding-right:0;">
											<div class="content-box">
												<figure class="image">
													<% if doctor.photo.attached? %>
														<%= image_tag url_for(doctor.photo), class: "border-radius-8", style: "width:80px;" %>
													<% else %>
														<%= image_tag "doctor-avatar.png", class: "border-radius-8", style: "width:80px;" %>
													<% end %>
												</figure>
												<h4 class="name"><%= link_to doctor.profesional_name, doctor_path(doctor), class: "text-black" %></h4>
												<span class="designation">Available Today</span>
												<div style="font-size:14px;margin-bottom:20px;">
												</div>
												<a href="https://wa.me/<%= configatron.wa_number %>?text=<%= url_encode("Halo saya ingin menjadwalkan appointment \ndengan *#{doctor.profesional_name}* \npada (TANGGAL DAN JAM)\n\nNama: \nNIK: \nTgl Lahir: \nJenis Kelamin: \nNo.HP: ") %>" class="theme-btn btn-style-three small">Make Appointment</a>
											</div>
										</div>
									</div>
								<% end %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
    <!-- End Sidebar Container -->
