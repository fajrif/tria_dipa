<!-- Fun Fact Section -->
<section class="fun-fact-section style-two">
	<div class="auto-container">
		<div class="row wow fadeInUp">
			<!-- Category Block -->
			<div class="category-block-three -type-2 col-lg-3 col-md-6 col-12">
				<div class="inner-box" onclick="location.href='<%= doctors_path %>';">
					<div class="content">
						<%= image_tag("icons/doctor.png") %>
						<h4><a href="<%= doctors_path %>">FIND DOCTORS</a></h4>
						<p>Take a look at our directory and connect with the healthcare professional you are <br/>looking for.</p>
						<%= link_to "Learn More", "/doctors", class: "theme-btn btn-style-three btn-transparent small" %>
					</div>
				</div>
			</div>
			<!-- Category Block -->
			<div class="category-block-three -type-2 col-lg-3 col-md-6 col-12">
				<div class="inner-box" onclick="location.href='<%= specialists_path %>';">
					<div class="content">
						<%= image_tag("icons/stetoscope.png") %>
						<h4><a href="<%= specialists_path %>">BROWSE SPECIALISTS</a></h4>
						<p>Explore the wide range of specialties we offer, and find the right highly qualified specialist for your specific health needs.</p>
						<%= link_to "Learn More", "/specialists", class: "theme-btn btn-style-three btn-transparent small" %>
					</div>
				</div>
			</div>
			<!-- Category Block -->
			<div class="category-block-three -type-2 col-lg-3 col-md-6 col-12">
				<div class="inner-box">
					<div class="content">
						<%= image_tag("icons/calendar.png") %>
						<h4><a href="#">MAKE AN APPOINTMENT</a></h4>
						<p>Schedule your healthcare visit by following these quick and easy steps. Let’s make your health a priority today</p>
						<%= link_to "Learn More", "#", class: "theme-btn btn-style-three btn-transparent small" %>
					</div>
				</div>
			</div>
			<!-- Category Block -->
			<div class="category-block-three -type-2 col-lg-3 col-md-6 col-12">
				<div class="inner-box" onclick="location.href='<%= contact_path %>';">
					<div class="content">
						<%= image_tag("icons/location.png") %>
						<h4><a href="<%= contact_path %>">LOCATE TRIA DIPA</a></h4>
						<p>Get the information you need to reach us in a breeze with a map of our location and detailed directions.</p>
						<%= link_to "Learn More", "/contact", class: "theme-btn btn-style-three btn-transparent small" %>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- Fun Fact Section -->
