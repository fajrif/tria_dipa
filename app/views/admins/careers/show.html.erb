<% title_page("Career Details") %>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body">
				<table class="table table-hover">
					<tr>
						<td style="width:15%;"><b>ID</b></td>
						<td><%= @career.id %></td>
					</tr>
					<tr>
						<td><b>Title</b></td>
						<td><h5 class="fs-14 mb-0 text-body"><%= @career.title %></h5></td>
					</tr>
					<tr>
						<td><b>Description</b></td>
						<td><%= raw @career.description %></td>
					</tr>
					<tr>
						<td><b>Date</b></td>
						<td><%= @career.date.strftime('%d/%m/%Y') %></td>
					</tr>
				</table>
				<div class="form-actions">
					<%= link_to 'Edit', edit_admins_career_path(@career.id), :class => 'btn btn-secondary' %>
					<%= link_to 'Destroy', admins_career_path(@career.id), :confirm => 'Are you sure?', :method => :delete, :class => 'btn btn-danger' %>
					<%= link_to 'View All', admins_careers_path, :class => 'btn btn-light' %>
				</div>
			</div>
		</div>
	</div>
</div>
